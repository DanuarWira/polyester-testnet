# ===================================================================
# POLYESTER TESTNET API CREDENTIALS
# ===================================================================
# Dapatkan kredensial ini dari Dashboard Polyester Testnet:
# 1. API Key ID & Private Key: Menu "API" -> "Create Key" (Simpan private key segera!)
# 2. Account ID: Menu "Profile" -> Salin "Account ID" (format Base58, misal: RLxqJGUDg92)
# ===================================================================
POLYESTER_API_KEY_ID=ak_testnet_your_api_key_id_here
POLYESTER_API_PRIVATE_KEY=your_64_character_hex_private_key_here
POLYESTER_ACCOUNT_ID=your_account_id_here
POLYESTER_API_URL=https://api.testnet.polyester.com
POLYESTER_WS_URL=wss://api.testnet.polyester.com

# ===================================================================
# TRADING BOT & MULTI-PAIR CONFIGURATION
# ===================================================================
# Daftar pasangan trading yang diproses secara paralel (dipisahkan koma)
TRADING_PAIRS=BTC-USDT,ETH-USDT,BNB-USDT

# Jumlah order grid per sisi (misal: 3 = 3 order beli di bawah mid dan 3 order jual di atas mid)
GRID_LEVELS=3

# Persentase selisih harga per level grid (misal: 0.002 = 0.20% per step)
GRID_SPREAD_PCT=0.0025

# Ukuran modal per order dalam USD (USDT equivalent)
ORDER_SIZE_USDT=50.0

# ===================================================================
# INVENTORY SKEWING & RISK MANAGEMENT
# ===================================================================
# Batas maksimal nilai koin (base asset) yang boleh diakumulasi per pair (dalam USD)
MAX_INVENTORY_USD_PER_PAIR=300.0

# Circuit Breaker: Batas maksimal pelebaran spread pasar (misal: 0.015 = 1.5%)
# Jika spread pasar melebar di atas angka ini, order aktif otomatis dibatalkan dan bot jeda sejenak.
CIRCUIT_BREAKER_SPREAD_PCT=0.015

# Interval polling orderbook & rekonsiliasi grid (detik)
UPDATE_INTERVAL_SECONDS=3.0

# ===================================================================
# VIP 1 TARGET TRACKER
# ===================================================================
# Target akumulasi volume trading 30 hari untuk mencapai VIP 1 (dalam USD)
TARGET_30D_VOLUME_USD=100000.0

# Saldo portofolio target (USD)
MIN_PORTFOLIO_USD=1000.0

# ===================================================================
# RUNTIME & LOGGING
# ===================================================================
LOG_LEVEL=INFO
DRY_RUN=false
